# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python

# ── Virtual environments ───────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Model artifacts (large binary files) ──────────────────────────────────────
# Keep metrics, plots, and CSVs; exclude large pickled models and run dirs
artifacts/*/naive_model.pkl
artifacts/*/ridge_model.pkl
artifacts/*/best_model.pkl
artifacts/*/feature_metadata.pkl
artifacts/*/xgboost_model.pkl
artifacts/*/lgbm_model.pkl

# Exclude all run directories (binary/large) — use git notes or model_info.json
artifacts/run_*/

# Optuna SQLite study database (large, regeneratable)
artifacts/optuna_study.db
artifacts/*.db

# Keep the artifacts folder structure itself
!artifacts/.gitkeep

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
artifacts/*/run.log

# ── Analysis outputs (regeneratable artefacts) ───────────────────────────────
analysis/outputs/

# ── Real data (may be large or sensitive) ─────────────────────────────────────
data/tfl_merged.csv
data/real/
data/collection.log

# Keep the data folder structure
!data/.gitkeep

# ── IDE and editor files ───────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── OS files ──────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── Distribution / packaging ──────────────────────────────────────────────────
dist/
build/
*.egg-info/
*.egg

# ── Test coverage ─────────────────────────────────────────────────────────────
.coverage
.coverage.*
htmlcov/
.pytest_cache/

# ── Environment variables ─────────────────────────────────────────────────────
.env
.env.*
!.env.example